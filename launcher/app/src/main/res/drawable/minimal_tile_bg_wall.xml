<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal home tile over a wallpaper: darker so the icon stays readable on a photo. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2EFFFFFF" />
            <stroke android:width="1.5dp" android:color="#D9FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#99141418" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
