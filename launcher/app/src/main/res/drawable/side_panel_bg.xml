<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings side panel: frosted dark sheet with a hairline left edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F218191F" />
        </shape>
    </item>
    <item android:width="1dp" android:gravity="start">
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
        </shape>
    </item>
</layer-list>
