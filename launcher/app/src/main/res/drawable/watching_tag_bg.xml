<?xml version="1.0" encoding="utf-8"?>
<!-- Inputs dropdown: the WATCHING tag on the current input. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF3B4BD8" />
            <corners android:radius="99dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#593B4BD8" />
            <stroke android:width="1dp" android:color="#FF6E7BFF" />
            <corners android:radius="99dp" />
        </shape>
    </item>
</selector>
