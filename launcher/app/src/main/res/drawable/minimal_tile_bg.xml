<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal home tile: a dark glass card with a hairline edge; focused, lighter with a white ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#21FFFFFF" />
            <stroke android:width="1.5dp" android:color="#D9FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0EFFFFFF" />
            <stroke android:width="1dp" android:color="#12FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
