<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal home tile's ring, drawn over its banner or colour fill: white when focused, a hairline otherwise.
     The card's rounded outline clips the outer half of the stroke. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <stroke android:width="4dp" android:color="#F2FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#1FFFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
